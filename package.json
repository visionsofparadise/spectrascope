{
	"private": true,
	"name": "spectrascope",
	"packageManager": "npm@12.0.1",
	"type": "module",
	"workspaces": [
		"apps/*",
		"packages/*"
	],
	"scripts": {
		"fix": "concurrently -m 1 --group \"prettier --write .\" \"turbo fix\" \"stylelint \\\"**/*.css\\\" --fix --allow-empty-input --cache\" \"markdownlint-cli2 --fix \\\"**/*.md\\\"\" \"textlint --fix \\\"**/*.md\\\"\"",
		"check": "concurrently --group \"prettier --check .\" \"turbo check\" \"stylelint \\\"**/*.css\\\" -f unix --allow-empty-input --cache\" \"markdownlint-cli2 \\\"**/*.md\\\"\" \"textlint -f compact \\\"**/*.md\\\"\" \"knip --no-progress\" \"jscpd .\" \"node tools.mjs run actionlint\"",
		"unit": "turbo unit",
		"build": "turbo build",
		"start": "turbo start",
		"prepare": "node -e \"import('node:child_process').then(({execSync})=>{try{execSync('git rev-parse --is-inside-work-tree',{stdio:'ignore'});execSync('git config core.hooksPath .githooks')}catch{}})\" && node tools.mjs install",
		"package-check": "check-dependency-version-consistency ."
	},
	"devDependencies": {
		"@commitlint/cli": "^21.2.2",
		"@commitlint/config-conventional": "^21.2.2",
		"@eslint/compat": "^2.1.1",
		"@eslint/js": "^9.0.0",
		"@html-eslint/eslint-plugin": "^0.65.0",
		"@stylistic/eslint-plugin": "^5.10.0",
		"@types/node": "^26.4.1",
		"check-dependency-version-consistency": "^4.1.0",
		"concurrently": "^9.0.0",
		"eslint": "^9.0.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-formatter-unix": "^9.0.1",
		"eslint-import-resolver-typescript": "^4.4.5",
		"eslint-plugin-barrel-files": "^2.1.0",
		"eslint-plugin-comment-rules": "^0.1.7",
		"eslint-plugin-import-x": "^4.0.0",
		"eslint-plugin-jsx-a11y": "^6.10.2",
		"eslint-plugin-react": "^7.37.0",
		"eslint-plugin-react-hooks": "^5.0.0",
		"globals": "^15.0.0",
		"jscpd": "^5.1.2",
		"knip": "^6.34.0",
		"markdownlint-cli2": "^0.23.2",
		"prettier": "^3.9.6",
		"stylelint": "^17.15.0",
		"stylelint-config-recommended": "^18.0.0",
		"textlint": "^15.8.0",
		"textlint-filter-rule-comments": "^1.3.0",
		"textlint-rule-no-dead-link": "^6.2.3",
		"turbo": "^2.9.6",
		"typescript": "^5.7.0",
		"typescript-eslint": "^8.0.0"
	},
	"allowScripts": {
		"electron@40.8.0": true,
		"electron-winstaller@5.4.4": true,
		"esbuild@0.25.12": true,
		"esbuild@0.27.7": true,
		"esbuild@0.21.5": true,
		"ffmpeg-static@5.3.0": true,
		"unrs-resolver@1.12.2": true
	}
}
